APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The public marketing site's origin, allowed to POST to /public/leads (CORS).
MARKETING_SITE_URL=https://classicdriving.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required in production to send the daily database backup email (set
# MAIL_MAILER=brevo to actually use it).
BREVO_API_KEY=

# Required to send SMS reminders via Termii; left blank, SMS sending is
# silently skipped.
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# WhatsApp backup channel (via Twilio) for the same reminders - used only
# when the Termii SMS send fails or isn't configured. Requires a Twilio
# account, an approved WhatsApp sender, and a Content Template SID
# (HXxxxxxxxx...) per reminder type, created in the Twilio console. Left
# blank, WhatsApp sending is silently skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_BALANCE_REMINDER_TEMPLATE_SID=
TWILIO_WHATSAPP_THEORY_REMINDER_TEMPLATE_SID=
TWILIO_WHATSAPP_THEORY_CANCELLATION_TEMPLATE_SID=
TWILIO_WHATSAPP_LEAD_FOLLOWUP_TEMPLATE_SID=
TWILIO_WHATSAPP_ABSENCE_CHECK_IN_TEMPLATE_SID=
TWILIO_WHATSAPP_TRAINING_DAYS_REMAINING_TEMPLATE_SID=
TWILIO_WHATSAPP_TRAINING_COMPLETED_TEMPLATE_SID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Required to receive online booking deposit payments from the marketing
# site (classicdriving.com.ng) via Paystack. The secret key verifies the
# webhook's signature - left blank, every webhook is rejected rather than
# trusted unsigned.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
